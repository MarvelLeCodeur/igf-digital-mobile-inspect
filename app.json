{
  "expo": {
    "name": "IGF Inspect",
    "slug": "igf-inspect",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "cd.gouv.igf.inspect"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "cd.gouv.igf.inspect"
    },
    "scheme": "cd.gouv.igf.inspect",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/igf-logo-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16243E"
        }
      ],
      "expo-notifications"
    ],
    "owner": "vinho10",
    "version": "1.0.0",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "027c5da6-7a61-4173-a246-f374e5252241"
      }
    }
  }
}
